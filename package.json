{
  "name": "planmaster",
  "version": "2.3.4",
  "description": "PlanMaster - 计划管理 & 心愿兑换",
  "main": "electron/main.js",
  "author": "MCGAgain",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "cd frontend && npm run build",
    "build:electron": "electron-builder",
    "build:all": "npm run build && npm run build:electron",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.planmaster.app",
    "productName": "PlanMaster",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "app.py",
      "database.py",
      "ai_service.py",
      "updater.py",
      "static/**/*",
      "templates/**/*",
      "!frontend/**/*",
      "!release/**/*",
      "!dist/**/*",
      "!*.dmg",
      "!*.exe"
    ],
    "extraResources": [
      {
        "from": "static/",
        "to": "static/"
      },
      {
        "from": "templates/",
        "to": "templates/"
      },
      {
        "from": "dist/PlanMaster-Backend/",
        "to": "backend/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "static/icon.jpg",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "forceCodeSigning": false
    },
    "win": {
      "icon": "static/icon.jpg",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "static/icon.jpg",
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0"
  }
}
